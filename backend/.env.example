# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection (Local or MongoDB Atlas Cloud)
# Local instance:
MONGO_URI=mongodb://127.0.0.1:27017/saffron_plate

# Or MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/saffron_plate?retryWrites=true&w=majority
